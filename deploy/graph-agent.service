[Unit]
Description=Graph Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=@GRAPH_AGENT_USER@
Group=@GRAPH_AGENT_USER@
WorkingDirectory=@GRAPH_AGENT_DIR@
ExecStart=@GRAPH_AGENT_DIR@/.venv/bin/graph-agent --config @GRAPH_AGENT_DIR@/config.yaml serve
EnvironmentFile=-/etc/graph-agent/env
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# ProtectKernelTunables=true makes /proc/sys a locked read-only mount; bubblewrap
# then gets EPERM mounting its own /proc ("Can't mount proc ... Operation not permitted").
# The sandbox already runs in its own user+mount namespace, so leave it off here.
# If bubblewrap refuses to start, relax NoNewPrivileges (setuid bwrap vs. userns).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@GRAPH_AGENT_DIR@
PrivateTmp=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictRealtime=true
UMask=0077

MemoryHigh=768M
MemoryMax=1G

[Install]
WantedBy=multi-user.target